; omult32.a
; from Colin Leroy-Mira (https://github.com/TobyLobster/multiply_test/pull/8)
;
; 16 bit x 16 bit unsigned multiply, 16 bit result
; Average cycles: 138.35
; 2144 bytes


inputA = $02        ; 2 bytes (a0,a1)
inputB = $04        ; 2 bytes (b0,b1)
result = $06        ; 4 bytes

* = $0200

; Tables must be aligned with page boundary
sqrLow
    !for i, 0, 511 {
        !byte <((i*i)/4)
    }

sqrHigh
    !for i, 0, 511 {
        !byte >((i*i)/4)
    }

iSqrLow
    !for i, 0, 511 {
        !byte <(((i-255)*(i-255))/4)
    }

iSqrHigh
    !for i, 0, 511 {
        !byte >(((i-255)*(i-255))/4)
    }

; ***************************************************************************************
; 16 bit x 16 bit unsigned multiply, 16 bit result (low bytes);
; Carry set if overflow
;
; On Entry:
;   inputA: multiplier   (2 bytes)
;   inputB: multiplicand (2 bytes)
;
; On Exit:
;   result: product (2 bytes)
mult
  ldy #0               ; init result to zero
  sty result+1         ; costs 8 cycles but the shortcuts
  sty result           ; are worth it

AlBl                   ; multiply low bytes
  lda inputA
  ldx inputB
  beq BhAl             ; Skip both 8x8 mults with B's low byte if it's 0
  sta sm1
  sta sm3
  eor #$ff
  sta sm2
  sta sm4

  sec
sm1 = * + 1
  lda sqrLow,x
sm2 = * + 1
  sbc iSqrLow,x
  sta result           ; Save temp result's low byte
sm3 = * + 1
  lda sqrHigh,x
sm4 = * + 1
  sbc iSqrHigh,x
  sta result+1         ; Save temp result's high byte


AhBl                   ; multiply A high by X low (X is still inputB)
  lda inputA+1
  beq BhAl             ; Skip if inputA high byte is 0
  sta sm5
  eor #$ff
  sta sm6

  sec                  ; Compute only the low byte
sm5 = * + 1            ; we have nowhere to store the
  lda sqrLow,x         ; high one anyway
sm6 = * + 1
  sbc iSqrLow,x
  clc
  adc result+1         ; Add to result's high byte
  sta result+1

BhAl                   ; multiply A low by X high
  lda inputA
  beq skipLast
  ldx inputB+1
  beq skipLast
  sta sm7
  eor #$ff
  sta sm8

  sec
sm7 = * + 1
  lda sqrLow,x
sm8 = * + 1
  sbc iSqrLow,x
  clc
  adc result+1         ; Add to result's high byte
  sta result+1         ; We're done
skipLast
  rts
